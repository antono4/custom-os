#
# Linux Kernel Configuration
# Custom Linux Distribution v1.0
#

CONFIG_VERSION_SIGNATURE="Custom LFS 6.4"
CONFIG_LOCALVERSION="-custom-lfs"
CONFIG_LOCALVERSION_AUTO=y

# Processor type
CONFIG_M386=y
CONFIG_M486=y
CONFIG_M586=y
CONFIG_M586TSC=y
CONFIG_M686=y
CONFIG_X86=y
CONFIG_X86_32=y
CONFIG_X86_64=n

# Memory management
CONFIG_IDE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_SD=y

# File systems
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_UDF_FS=y

# Networking
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_NETDEVICES=y
CONFIG_ETH_PHY=y

# Device drivers
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# USB support
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_STORAGE=y

# Input devices
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y

# Graphics
CONFIG_FB_VESA=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_HID_GENERIC=y

# Sound
CONFIG_SOUND=y
CONFIG_SND=y

# System
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_EMBEDDED=n
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y